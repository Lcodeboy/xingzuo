      "__id__": 181
    },
    "_enabled": true,
    "__prefab": null,
    "_lineHeight": 46,
    "_string": "<outline color=#E4D6F0 width=1><color=#3A285F><b>03  沟通与冲突</b></color></outline>\n<color=#54436F>误会常从表达速度、语气或沉默产生；先复述对方需求，再说明自己的立场，更容易恢复合作。</color>",
    "_horizontalAlign": 0,
    "_fontSize": 32,
    "_maxWidth": 750,
    "_fontFamily": "Arial",
    "_font": null,
    "_isSystemFontUsed": true,
    "_userDefinedFont": null,
