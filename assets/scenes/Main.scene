      "__id__": 178
    },
    "_enabled": true,
    "__prefab": null,
    "_lineHeight": 46,
    "_string": "<outline color=#E4D6F0 width=1><color=#3A285F><b>02  爱的表达</b></color></outline>\n<color=#54436F>在乎可能通过表态、陪伴或行动表达；直接说清最需要的回应，会比互相猜测更有效。</color>",
    "_horizontalAlign": 0,
    "_fontSize": 32,
    "_maxWidth": 750,
    "_fontFamily": "Arial",
    "_font": null,
    "_isSystemFontUsed": true,
    "_userDefinedFont": null,
