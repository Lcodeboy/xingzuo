      "__id__": 175
    },
    "_enabled": true,
    "__prefab": null,
    "_lineHeight": 46,
    "_string": "<outline color=#E4D6F0 width=1><color=#3A285F><b>01  心动来源</b></color></outline>\n<color=#54436F>彼此的性格亮点会带来好奇，具体欣赏与共同体验能让吸引逐渐落到真实相处中。</color>",
    "_horizontalAlign": 0,
    "_fontSize": 32,
    "_maxWidth": 750,
    "_fontFamily": "Arial",
    "_font": null,
    "_isSystemFontUsed": true,
    "_userDefinedFont": null,
    "_cacheMode": 0,
    "_imageAtlas": null,
    "_handleTouchEvent": false,
    "_id": "detailItemRichText177"
  },
